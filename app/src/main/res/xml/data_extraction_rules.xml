<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later ignore allowBackup for a transfer to a new device: nothing of the app, the Tesla session, the
    orders, their history or the checklist photos, leaves the phone, by cloud backup or by device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
